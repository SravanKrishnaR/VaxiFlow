{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VaxiFlow",
  "description": "Automated reverse vaccinology pipeline for protein prioritization of genome, proteome, and pangenome-based vaccine candidate discovery",

  "$defs": {
    "INPUT_MODE": {
      "description": "Define the biological input used to run the pipeline. Exactly one input mode must be provided.",
      "properties": {
        "genome": {
          "description": "Single genome FASTA file for analysis",
          "format": "file-path"
        },
        "pangenome": {
          "description": "Multiple genome FASTA files for pangenome analysis",
          "format": "file-path"
        },
        "proteome": {
          "description": "Proteome FASTA file for protein-level reverse vaccinology analysis",
          "format": "file-path"
        }
      }
    },

    "PIPELINE_CONFIG": {
      "properties": {
        "outdir": {
          "description": "Directory where pipeline results will be written",
          "default": "Results",
          "format": "directory-path"
        },
        "cpus": {
          "description": "Number of CPUs allocated per process",
          "default": 12
        },
        "memory": {
          "description": "Memory allocated per process",
          "default": "8 GB"
        },
        "publish_mode": {
          "description": "File publishing strategy for process outputs",
          "enum": ["copy", "link"],
          "default": "copy"
        },
        "pipeline_report": {
          "description": "Prefix for the pipeline execution report",
          "default": "pipeline_report"
        },
        "monochrome_logs": {
          "description": "Disable colored log output",
          "default": false
        }
      }
    },

    "EXECUTION_MODE": {
      "properties": {
        "mode": {
          "description": "Pipeline execution mode",
          "enum": ["filtered", "unfiltered"],
          "default": "unfiltered"
        }
      }
    },

    "PROKKA": {
      "properties": {
        "kingdom": {
          "description": "Kingdom used for genome annotation",
          "enum": ["Bacteria", "Archaea", "Mitochondria", "Viruses"],
          "default": "Bacteria"
        },
        "gram": {
          "description": "Gram staining classification",
          "enum": ["pos", "neg", ""],
          "default": "neg"
        }
      }
    },

    "ROARY": {
      "properties": {
        "identity": {
          "description": "Minimum percentage identity for core gene clustering",
          "default": 95
        }
      }
    },

    "CDHIT": {
      "properties": {
        "SequenceIdentity": {
          "description": "Sequence identity threshold",
          "default": 0.9
        },
        "WordLength": {
          "description": "Word length for clustering",
          "default": 5
        },
        "DescpLength": {
          "description": "Description length in output",
          "default": 0
        }
      }
    },

    "TOXINPRED": {
      "properties": {
        "threshold": {
          "description": "Toxicity prediction threshold",
          "minimum": 0,
          "maximum": 1,
          "default": 0.38
        },
        "model": {
          "description": "Prediction model",
          "enum": [1, 2],
          "default": 1
        }
      }
    },

    "DEEPLOCPRO": {
      "properties": {
        "group": {
          "description": "Organism group",
          "enum": ["negative", "positive", "archaea"],
          "default": "negative"
        },
        "device": {
          "description": "Compute device",
          "enum": ["cpu", "cuda", "mps"],
          "default": "cpu"
        }
      }
    },

    "ALGPRED": {
      "properties": {
        "threshold": {
          "description": "Allergenicity threshold",
          "minimum": 0,
          "maximum": 1,
          "default": 0.3
        }
      }
    },

    "SIGNALP": {
      "properties": {
        "organism": {
          "description": "Target organism group",
          "enum": ["other", "eukarya"],
          "default": "other"
        },
        "signalpMode": {
          "description": "Prediction mode",
          "enum": ["fast", "slow", "slow-sequential"],
          "default": "fast"
        }
      }
    },

    "HUMAN_HOMOLOGS": {
      "properties": {
        "homologsdb": {
          "description": "Human homologs DIAMOND database",
          "default": "/app/human_db.dmnd",
          "format": "file-path"
        }
      }
    },

    "VFDB": {
      "properties": {
        "vfdb": {
          "description": "VFDB DIAMOND database",
          "default": "/app/VFDB_db.dmnd",
          "format": "file-path"
        }
      }
    },

    "MHC_I": {
      "properties": {
        "MHC_I_method": {
          "description": "MHC I prediction method",
          "enum": ["ann", "netmhcpan_el", "netmhcpan_ba"],
          "default": "ann"
        },
        "MHC_I_length": {
          "description": "Peptide length",
          "default": 11
        },
        "MHC_I_alleles": {
          "description": "Allele list file",
          "default": "/app/Resources/ann_human_allele.txt",
          "format": "file-path"
        }
      }
    },

    "MHC_II": {
      "properties": {
        "MHC_II_method": {
          "description": "MHC II prediction method",
          "enum": [
            "consensus3",
            "comblib",
            "smm_align",
            "nn_align",
            "sturniolo",
            "netmhciipan_el",
            "netmhciipan_ba",
            "netmhciipan_el-4.3",
            "netmhciipan_el-4.2",
            "netmhciipan_ba-4.3",
            "netmhciipan_ba-4.2"
          ],
          "default": "consensus3"
        },
        "MHC_II_length": {
          "description": "Peptide length",
          "default": 15
        },
        "MHC_II_alleles": {
          "description": "Allele list file",
          "default": "/app/Resources/consensus3_alleles.txt",
          "format": "file-path"
        }
      }
    }
  },

  "properties": {
    "help": {
      "description": "Show pipeline help"
    },
    "helpFull": {
      "description": "Show full help including nested parameters"
    },
    "showHidden": {
      "description": "Show hidden parameters"
    }
  }
}
