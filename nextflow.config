nextflow.enable.dsl=2

params {
    cpus      = 12
    memory    = '8 GB'
    outdir    = 'Results'
    publish_mode = 'copy'

    //PROKKA
    kingdom   = 'Bacteria'
    gram = 'neg'
 
    //ROARY
    identity = 95

    //CD_HIT
    SequenceIdentity = 0.9    
    WordLength = 5
    DescpLength = 0

    //TOXINPRED
    threshold = 0.38
    model     = 1
    toxinpredDisplay   = 2

    //DEEPLOCPRO
    group     = 'negative'
    device    = 'cpu'

    //ALGPRED
    threshold = 0.3
    model     = 1
    algpredDisplay   = 1

    //SIGNALP
    organism  = 'other'
    format    = 'txt'
    signalpMode   = 'fast'

    pipeline_report = "pipeline_report"
    monochrome_logs = false
}

docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g)'
}

executor {
    name = 'local'
    cpus = params.cpus
}

conda.enabled = true

profiles {
    docker {
        docker.enabled = true
    }

    test_proteome {
	includeConfig "$baseDir/profiles/test_proteome.config"
    }

    test_genome {
        includeConfig "$baseDir/profiles/test_genome.config"
    }

    test_batchgenome {
        includeConfig "$baseDir/profiles/test_batchgenome.config"
    }
}

process {
    withName: PROKKA {
        cpus = 4
        memory = '8 GB'
        time = '1d'
    }

withName: ROARY {
        cpus = 4
        memory = '8 GB'
        time = '1d'
    }
    withName: ROARY_2 {
        cpus = 2
        memory = '4 GB'
        time = '1d'
    }
    withName: ALGPRED {
        cpus = 2
        memory = '6 GB'
        time = '30m'
    }
    withName: VFDB {
        cpus = 2
        memory = '4 GB'
        time = '1d'
    }
    withName: DEEPLOCPRO {
        cpus = 12
        memory = '8 GB'
        time = '1d'
        maxForks = 1
    }
    withName: DEEPTHMMM {
        cpus = 12
        memory = '8 GB'
        time = '1d'
        maxForks = 1
        conda = "bin/envs/deepthmmm.yml"
    }
    withName: DEEPTHMMM_2 {
        cpus = 2
        memory = '4 GB'
        time = '30m'
    }
    withName: SIGNALP {
        cpus = 12
        memory = '8 GB'
        time = '1d'
        maxForks = 1
    }
    withName: HUMAN_HOMOLOGS {
        cpus = 2
        memory = '4 GB'
        time = '30m'
    }
    withName: TOXINPRED {
        cpus = 4
        memory = '6 GB'
        time = '1d'
    }
    withName: MHC_I {
        cpus = 4
        memory = '6 GB'
        time = '30m'
        conda = "bin/envs/mhc_iedb.yml"
    }
    withName: MHC_II {
        cpus = 4
        memory = '6 GB'
        time = '30m'
        conda = "bin/envs/mhc_iedb.yml"
    }
}


timeline {
    enabled = true
    file = "${params.pipeline_report}/execution_timeline_${new Date().format('yyyyMMddHHmmss')}.html"
}

report {
    enabled = true
    file = "${params.pipeline_report}/execution_report_${new Date().format('yyyyMMddHHmmss')}.html"
}

trace {
    enabled = true
    file = "${params.pipeline_report}/execution_trace_${new Date().format('yyyyMMddHHmmss')}.txt"
}

dag {
    enabled = true
    file = "${params.pipeline_report}/pipeline_dag_${new Date().format('yyyyMMddHHmmss')}.svg"
}
